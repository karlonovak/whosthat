# Copy per camera (e.g. kuca_ulaz.env) and fill in; real env files are git-ignored.
SERVER_PORT=9009
LOG_LEVEL=DEBUG
# motion: react to the camera's motion events (MOTION_ADDRESS); anything else polls every CAM_FREQUENCY_IN_S
TRIGGER_TYPE=motion

CAM_ADDRESS=
MOTION_ADDRESS=
CAM_USER=
CAM_PASS=
CAM_FREQUENCY_IN_S=5
CAM_CROP_RECTANGLES=

YOLO_WEIGHTS=/opt/darknet/yolov3.weights
YOLO_CONFIG=/opt/darknet/cfg/yolov3.cfg

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATION_THRESHOLD_IN_S=60
